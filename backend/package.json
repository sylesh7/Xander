{
  "name": "xander-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node --env-file=.env node_modules/vitest/vitest.mjs run test/mcp-connection.live.test.ts test/investigation-agent.db.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:seed:refresh": "tsx --env-file=.env prisma/seed.ts --refresh-only",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "substreams:pack": "node scripts/substreams-pack.mjs",
    "substreams:run": "node --env-file=.env --import tsx src/graph/substreams/run.ts --spkg substreams/xander_substreams-v0.1.0.spkg",
    "check:graph": "tsx --env-file=.env scripts/check-graph.ts",
    "check:verdict": "tsx --env-file=.env scripts/check-verdict.ts",
    "check:mcp": "tsx --env-file=.env scripts/check-mcp.ts",
    "check:investigation": "tsx --env-file=.env scripts/check-investigation.ts",
    "check:ens": "tsx --env-file=.env scripts/check-ens.ts",
    "ens:register-parent": "tsx --env-file=.env scripts/ens-register-parent.ts",
    "ens:deploy-registry": "tsx --env-file=.env scripts/ens-deploy-registry.ts",
    "check:ens-agent": "tsx --env-file=.env scripts/check-ens-agent.ts",
    "worker": "tsx --env-file=.env src/workflow/worker.ts",
    "check:agent-ens": "tsx --env-file=.env scripts/check-agent-ens.ts"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@connectrpc/connect": "^1.3.0",
    "@connectrpc/connect-node": "^1.3.0",
    "@mastra/core": "^1.64.0",
    "@mastra/mcp": "^1.17.3",
    "@prisma/client": "^6.1.0",
    "@substreams/core": "^0.16.0",
    "@temporalio/activity": "^1.23.0",
    "@temporalio/client": "^1.23.0",
    "@temporalio/worker": "^1.23.0",
    "@temporalio/workflow": "^1.23.0",
    "@worldcoin/idkit-core": "^4.2.4",
    "bullmq": "^6.3.4",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "ioredis": "^6.0.0",
    "pino": "^9.6.0",
    "viem": "^2.56.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@temporalio/testing": "^1.23.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
