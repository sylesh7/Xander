# =============================================================================
# XANDER — shared .env.example
# =============================================================================
# SUGANTHAN's section (Backend-Suganthan.md Section 0.6) is below, verbatim.
# SYLESH's section (Backend-Sylesh.md Section 0.6) is stubbed at the bottom so
# it can be filled in without a merge conflict. Do not reorder these sections.
#
# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#
# `npm test` never loads this file — it stays deterministic and free of network
# calls. `npm run test:live` does (`node --env-file=.env vitest.mjs run ...`)
# and exercises the real Subgraph MCP connection and, if OPENROUTER_API_KEY is
# set, a real investigation end to end. `npm run dev`, `npm run db:seed`, and
# every `npm run check:*` script load it too.
# =============================================================================

# --- SUGANTHAN: Phases 1-12 (Evidence & Risk Engine) -------------------------

NODE_ENV=development
DATABASE_URL=postgresql://user:pass@localhost:5433/xander   # host port remapped off 5432 to avoid clashing with other local Postgres containers
REDIS_URL=redis://localhost:6380                            # host port remapped off 6379 to avoid clashing with other local Redis containers

GRAPH_MARKET_API_TOKEN=            # Phase 1 — Token API bearer JWT
TOKEN_API_BASE_URL=https://token-api.thegraph.com
TOKEN_API_NETWORKS=arbitrum-one,avalanche,base,bsc,hyperevm,mainnet,optimism,polygon,unichain
TOKEN_API_DEFAULT_NETWORK=mainnet
TOKEN_API_MAX_ITEMS=10          # free-tier cap; API 403s above this, it does not truncate
GRAPH_GATEWAY_API_KEY=             # Subgraph Studio -> "API Keys" tab -> Create API Key (NOT the deploy key). Phase 4 + Sylesh Phase 15 (MCP)
GRAPH_GATEWAY_BASE_URL=https://gateway.thegraph.com
GRAPH_GATEWAY_AUTH_MODE=header     # 'header' = Authorization: Bearer (documented); 'path' = legacy key-in-URL
DEPLOYMENT_REGISTRY_TTL_SECONDS=300

ENABLE_SUBSTREAMS=true             # locked P0 — don't feature-flag this off
SUBSTREAMS_ENDPOINT=   # Phase 9 — single-endpoint fallback
SUBSTREAMS_DEFAULT_NETWORK=base-sepolia    # demo/build target while building; flip to a mainnet chain at ship time
# gRPC host:port pairs — NO https:// prefix. Verified reachable 2026-09-08.
# Pinax matches the issuer of GRAPH_MARKET_API_TOKEN, which already carries
# substreams_plan_tier: FREE — the same token authenticates here.
# StreamingFast alternatives: mainnet.eth.streamingfast.io:443,
#                             sepolia.eth.streamingfast.io:443
# Holesky is sunset and no longer resolves.
SUBSTREAMS_ENDPOINTS=mainnet=eth.substreams.pinax.network:443,sepolia=sepolia.substreams.pinax.network:443,base-sepolia=basesepolia.substreams.pinax.network:443
SUBSTREAMS_WEBHOOK_SECRET=         # Phase 10

# Phase 6/7 tunables. Section 0.2 rule 1: knobs are config, never inline numbers.
PORT=3000
EDGE_THRESHOLD=0.5                 # Phase 6 — min pairwise score to draw a graph edge
MIN_CLUSTER_SIZE=2                 # Phase 6 — components smaller than this are not clusters
FUNDING_LOOKBACK_HOPS=1            # Phase 7 — direct funder only; >1 is real graph traversal
FUNDING_WINDOW_HOURS=24            # Phase 7 — shared-funder grouping window
TIMING_NORMALIZATION_SECONDS=3600  # Phase 7 — TIMING_CORRELATION normalizer
AGE_NORMALIZATION_BLOCKS=50000     # Phase 7 — WALLET_AGE_SIMILARITY normalizer
FRESHNESS_MAX_BLOCK_LAG=100        # Phase 11 — beyond this lag, evidence yields PENDING_REVIEW
FRESHNESS_MAX_EVIDENCE_AGE_SECONDS=21600  # 6h — token-api/subgraph evidence recency (Phase 11)
FRESHNESS_MAX_STREAM_LAG_SECONDS=900      # 15min — substreams cursor recency (Phase 11)
PROTOCOL_SEQUENCE_MAX_LENGTH=200   # Phase 7 — LCS comparison cap per wallet

# --- SYLESH: Phases 13-25 (Decision, Escalation & API) -----------------------
# Owned by Backend-Sylesh.md Section 0.6. Every credential below is optional at
# boot and read through a require* helper in src/config/env.ts, so the server
# starts without World access and the affected route reports 503 instead.

SUBGRAPH_MCP_URL=https://subgraphs.mcp.thegraph.com/sse   # confirmed endpoint, Phase 15

WORLD_APP_ID=                     # app_...  (backward-compat fallback only)
WORLD_RP_ID=                      # rp_...   (primary identifier)
WORLD_RP_SIGNING_KEY=             # secret — feeds signRequest(), server-side only, never sent to client
WORLD_ACTION_PREFIX=claim         # actions built as `${WORLD_ACTION_PREFIX}-${campaignId}`
WORLD_VERIFY_BASE_URL=https://developer.world.org

BACKEND_API_KEY=                  # Phase 22 — X-API-Key your own /screen-claim, /world/* routes require

# Phase 14 — risk cache. TTL is a safety net; correctness comes from the
# explicit risk-invalidation eviction, not from expiry.
RISK_CACHE_ENABLED=true
RISK_CACHE_TTL_SECONDS=3600

# Phases 16-20 — World escalation. The two clocks are NOT interchangeable:
# VALIDITY_DAYS is how long a PASSED proof counts as "still verified" (Selfie
# Check's documented 90-day window); TTL_MINUTES is how long an unanswered
# prompt stays open before it is expired and re-issued.
WORLD_CHALLENGE_VALIDITY_DAYS=90
WORLD_CHALLENGE_TTL_MINUTES=30
WORLD_VERIFY_TIMEOUT_MS=10000
WORLD_VERIFY_MAX_ATTEMPTS=3       # retries TRANSIENT failures only; a rejection is never retried

# Phase 15 — Subgraph MCP investigation agent. MAX_STEPS is the tool-call budget;
# an unbounded agent against a metered gateway is a cost and availability problem.
MCP_INVESTIGATION_MAX_STEPS=8
MCP_INVESTIGATION_TIMEOUT_MS=120000
# Output-token ceiling. Without this the provider default (64000) is reserved
# against the request budget before any work happens — absurd for a short
# grounded summary, and OpenRouter 402s outright if that ceiling exceeds your
# remaining balance.
MCP_INVESTIGATION_MAX_OUTPUT_TOKENS=2000
# Comma-separated allowlist of MCP tool names (server's own vocabulary — see
# `npm run check:mcp`). Every tool's schema is sent on every model call; the
# full set costs real prompt tokens for capabilities this agent's narrow
# mandate does not need. Empty means all tools.
MCP_INVESTIGATION_TOOLS=search_subgraphs_by_keyword,get_schema_by_deployment_id,execute_query_by_deployment_id,get_deployment_30day_query_counts
# Model routing goes through OpenRouter so the model is a config change, not a
# dependency change. Mastra supports the `openrouter` provider natively — it
# reads OPENROUTER_API_KEY itself and sends `Authorization: Bearer <key>`.
# Format is openrouter/<openrouter-model-id>, e.g. openrouter/openai/gpt-4o.
MCP_INVESTIGATION_MODEL=openrouter/anthropic/claude-sonnet-4.5
OPENROUTER_API_KEY=               # https://openrouter.ai/keys
# Only needed if you switch MCP_INVESTIGATION_MODEL to a bare anthropic/* id.
ANTHROPIC_API_KEY=
# NOTE ON OPENROUTER FREE-TIER KEYS: a key with zero purchased credits
# (`is_free_tier: true` per https://openrouter.ai/api/v1/key) gets a small,
# fluctuating per-request PROMPT token ceiling (observed 5197-11530 tokens on
# 2026-09-09) that the defaults above can exceed — the call 402s with
# "Prompt tokens limit exceeded" before making a single tool call. Verified
# fix for a free-tier key: MCP_INVESTIGATION_MODEL=openrouter/openai/gpt-4o-mini,
# MCP_INVESTIGATION_TOOLS trimmed to 2 tools, MCP_INVESTIGATION_MAX_OUTPUT_TOKENS=500.
# A funded account does not need any of this.
# REQUIRED IN PRACTICE, not optional. The hosted SSE endpoint above was verified
# BROKEN on 2026-09-09 (HTTP 200, text/event-stream, then zero bytes — the MCP
# handshake never gets its `endpoint` event; same result with the official MCP
# SDK and with an invalid key, while other SSE streams work fine from the same
# machine). Setting this runs the same upstream server locally over stdio, which
# is verified working: `npm run check:mcp`.
#   git clone https://github.com/graphops/subgraph-mcp && cd subgraph-mcp
#   cargo build --release   ->   target/release/subgraph-mcp   (.exe on Windows)
# Windows note: upstream does not compile as-is — src/main.rs calls
# tokio::signal::unix unconditionally, which is #![cfg(unix)]-gated. Wrap that
# block in #[cfg(unix)] with a tokio::signal::ctrl_c() fallback.
SUBGRAPH_MCP_COMMAND=

# Phase 22 — rate limiting on the routes that spend upstream quota.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
