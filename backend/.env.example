# =============================================================================
# SYBIL SHIELD — shared .env.example
# =============================================================================
# SUGANTHAN's section (Backend-Suganthan.md Section 0.6) is below, verbatim.
# SYLESH's section (Backend-Sylesh.md Section 0.6) is stubbed at the bottom so
# it can be filled in without a merge conflict. Do not reorder these sections.
#
# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# =============================================================================

# --- SUGANTHAN: Phases 1-12 (Evidence & Risk Engine) -------------------------

NODE_ENV=development
DATABASE_URL=postgresql://user:pass@localhost:5432/sybil_shield
REDIS_URL=redis://localhost:6379

GRAPH_MARKET_API_TOKEN=            # Phase 1 — Token API bearer JWT
TOKEN_API_BASE_URL=https://token-api.thegraph.com
TOKEN_API_NETWORKS=arbitrum-one,avalanche,base,bsc,hyperevm,mainnet,optimism,polygon,unichain
TOKEN_API_DEFAULT_NETWORK=mainnet
TOKEN_API_MAX_ITEMS=10          # free-tier cap; API 403s above this, it does not truncate
GRAPH_GATEWAY_API_KEY=             # Subgraph Studio -> "API Keys" tab -> Create API Key (NOT the deploy key). Phase 4 + Sylesh Phase 15 (MCP)
GRAPH_GATEWAY_BASE_URL=https://gateway.thegraph.com
DEPLOYMENT_REGISTRY_TTL_SECONDS=300

ENABLE_SUBSTREAMS=true             # locked P0 — don't feature-flag this off
SUBSTREAMS_ENDPOINT=               # Phase 9 — Firehose provider endpoint (e.g. Pinax-hosted)
SUBSTREAMS_WEBHOOK_SECRET=         # Phase 10

# Phase 6/7 tunables. Section 0.2 rule 1: knobs are config, never inline numbers.
PORT=3000
EDGE_THRESHOLD=0.5                 # Phase 6 — min pairwise score to draw a graph edge
MIN_CLUSTER_SIZE=2                 # Phase 6 — components smaller than this are not clusters
FUNDING_LOOKBACK_HOPS=1            # Phase 7 — direct funder only; >1 is real graph traversal
FUNDING_WINDOW_HOURS=24            # Phase 7 — shared-funder grouping window
TIMING_NORMALIZATION_SECONDS=3600  # Phase 7 — TIMING_CORRELATION normalizer
AGE_NORMALIZATION_BLOCKS=50000     # Phase 7 — WALLET_AGE_SIMILARITY normalizer
FRESHNESS_MAX_BLOCK_LAG=100        # Phase 11 — beyond this lag, evidence yields PENDING_REVIEW

# --- SYLESH: Phases 13-25 (Decision, Escalation & API) -----------------------
# Owned by Backend-Sylesh.md Section 0.6. Sylesh fills these in and adds the
# matching entries to src/config/env.ts. Left blank here on purpose.

SUBGRAPH_MCP_URL=https://subgraphs.mcp.thegraph.com/sse   # confirmed endpoint, Phase 15

WORLD_APP_ID=                     # app_...  (backward-compat fallback only)
WORLD_RP_ID=                      # rp_...   (primary identifier)
WORLD_RP_SIGNING_KEY=             # secret — feeds signRequest(), server-side only, never sent to client
WORLD_ACTION_PREFIX=claim         # actions built as `${WORLD_ACTION_PREFIX}-${campaignId}`
WORLD_VERIFY_BASE_URL=https://developer.world.org

BACKEND_API_KEY=                  # Phase 22 — X-API-Key your own /screen-claim, /world/* routes require
